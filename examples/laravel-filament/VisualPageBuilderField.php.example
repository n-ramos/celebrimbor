<?php

// src/Forms/Components/VisualPageBuilderField.php

namespace NRamos\Celebrimbor\Filament\Forms\Components;

use Filament\Forms\Components\Field;

class VisualPageBuilderField extends Field
{
    protected string $view = 'celebrimbor::visual-page-builder-field';

    // Serialised format posted back by <my-page-builder>: "portable" (flat array)
    // or "document" (full PageDocument). Defaults to portable.
    protected string $documentFormat = 'portable';

    public function documentFormat(string $format): static
    {
        $this->documentFormat = $format;

        return $this;
    }

    public function getDocumentFormat(): string
    {
        return $this->documentFormat;
    }
}
