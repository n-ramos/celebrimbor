{{-- resources/views/visual-page-builder-field.blade.php --}}
<x-dynamic-component
    :component="$getFieldWrapperView()"
    :field="$field"
>
    {{-- The <my-page-builder> element is provided by the bundle this package
         registers via FilamentAsset (resources/dist). It syncs a hidden
         <textarea name="..."> so Livewire/Filament picks the value up on submit. --}}
    <div wire:ignore>
        <my-page-builder
            name="{{ $getStatePath() }}"
            format="{{ $getDocumentFormat() }}"
            value="{{ filled($getState()) ? json_encode($getState()) : '[]' }}"
            class="block min-h-[600px]"
        ></my-page-builder>
    </div>
</x-dynamic-component>
