{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@n-ramos/celebrimbor-core": ["packages/core/src/index.ts"],
      "@n-ramos/celebrimbor-editor-react": ["packages/editor-react/src/index.ts"],
      "@n-ramos/celebrimbor-editor-element": ["packages/editor-element/src/index.tsx"],
      "@n-ramos/celebrimbor-symfony": ["packages/adapters/symfony-ux/src/index.ts"],
